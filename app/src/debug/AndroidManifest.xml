<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Runs LeakWatchSetup as the process starts. Debug builds only:
             the leak detector is not in a release build at all. -->
        <provider
            android:name=".LeakWatchSetup"
            android:authorities="${applicationId}.leak-watch-setup"
            android:exported="false" />
        <!-- Fork: moves the Frequent category's clock ahead (adb shell am broadcast, see the receiver).
             Debug builds only; the DUMP permission leaves it to the shell. -->
        <receiver
            android:name=".fork.frequent.FrequentShiftReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>

</manifest>
